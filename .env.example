# Copy this file to `.env` and fill in your own key.
# Get a free key at https://home.openweathermap.org/api_keys
# Note: Create React App inlines REACT_APP_* vars into the client bundle at
# build time, so this key is public. Use a free-tier key and restrict it.
VITE_OWM_KEY=your_openweather_api_key_here
